{
  "name": "tag-generator-for-concerts",
  "version": "3.0.0",
  "homepage": "https://allenhsieh.github.io/tagGeneratorForConcerts/",
  "description": "Pre-fill Archive.org upload metadata and tags for punk/hardcore/metal concert videos",
  "keywords": [
    "react",
    "punk",
    "hardcore",
    "metal",
    "tags",
    "social-media",
    "instagram",
    "archive.org"
  ],
  "type": "module",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "gh-pages": "^6.1.1",
    "typescript": "^5.5.4",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
